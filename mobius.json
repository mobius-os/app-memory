{
  "id": "memory",
  "name": "Memory",
  "version": "2.5.0",
  "description": "Build and retrieve an optional graph of durable facts without injecting it into every chat.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-memory",
  "entry": "index.jsx",
  "system_app": true,
  "system_prompt": "memory-core.md",
  "skills": [
    "memory.md"
  ],
  "icon": "icon.png",
  "offline_capable": true,
  "offline": {
    "reads": true,
    "writes": "none",
    "execution": "partial"
  },
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none",
    "shared_memory": "write",
    "chat_log_access": "summary_with_deleted"
  },
  "storage_seeds": {
    "settings.json": {
      "primary_agent_mode": "system",
      "provider": null,
      "model": null,
      "secondary_agent_mode": "system",
      "fallback_provider": null,
      "fallback_model": null
    }
  },
  "schedule": {
    "default": "30 5 * * *",
    "user_configurable": true,
    "job": "fetch.sh",
    "initialize_on_install": true
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "marked",
      "dompurify",
      "@openai/apps-sdk-ui/components/Icon"
    ]
  },
  "embeds_agent": false,
  "source_files": [
    "memory-core.md",
    "memory.md",
    "memory_search.py",
    "memory_read.py",
    "remember.py",
    "memory_benchmark.py",
    "service.py",
    "memory_text_provider.py",
    "memory_runner.py",
    "model_selection.py",
    "memory_store.py",
    "memory_graph.py",
    "personalization_profile.py",
    "constants.js",
    "model-selection.mjs",
    "theme.js",
    "domain.js",
    "storage.js",
    "graph/render.jsx",
    "graph/viewport.mjs",
    "ui/Th.jsx",
    "ui/MemoryList.jsx",
    "ui/EmptyConstellation.jsx",
    "ui/GraphGlyph.jsx",
    "ui/ListGlyph.jsx",
    "ui/ChatGlyph.jsx",
    "ui/TextGlyph.jsx",
    "ui/NetworkGlyph.jsx",
    "ui/BackgroundAgentList.jsx",
    "ui/SupportingChats.jsx",
    "ui/ActivityView.jsx",
    "ui/backgroundAgentOrder.js",
    "ui/ModelPicker.jsx",
    "seed-memory/index.md",
    "seed-memory/mocs/about-the-user.md",
    "seed-memory/mocs/building-mobius-apps.md",
    "seed-memory/mocs/maintaining-memory.md",
    "seed-memory/mocs/mobius-platform.md",
    "seed-memory/notes/how-the-memory-graph-works.md",
    "seed-memory/notes/memory-is-visible-to-the-partner.md"
  ],
  "agent_activities": {
    "memory-search": {
      "tool": "search",
      "running_label": "Searching"
    },
    "memory-read": {
      "tool": "read",
      "running_label": "Reading"
    },
    "memory-capture": {
      "tool": "remember",
      "running_label": "Saving"
    }
  },
  "service": {
    "entry": "service.py"
  },
  "tools": [
    {
      "name": "search",
      "description": "Search Memory for durable context about the partner (preferences, constraints, people, goals, projects, prior decisions and their impact) that could change this work. Describe the context needed and why, anchored to the relevant people, projects, or apps. Returns a catalogue of relevant notes and a lookup_id; open notes with Memory's read tool. Takes up to a few minutes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Focused description of the facts or prior context needed, and why."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "read",
      "description": "Continue a Memory lookup: page its catalogue (selection \"catalog\") or read full notes (selection \"all\" or a list of catalogue ids). Repeat with the returned cursor until complete.",
      "input_schema": {
        "type": "object",
        "properties": {
          "lookup_id": {
            "type": "string"
          },
          "selection": {
            "description": "\"catalog\", \"all\", or a list of catalogue ids.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "cursor": {
            "type": "string",
            "description": "\"start\" (default) or the next cursor the previous page returned."
          }
        },
        "required": [
          "lookup_id",
          "selection"
        ]
      }
    },
    {
      "name": "remember",
      "description": "Save one self-contained fact a future chat would want to know. Memory's nightly writer checks it against this chat before filing it.",
      "input_schema": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string",
            "description": "One fact that stands alone months from now: who and what, absolute dates, and the why when known."
          }
        },
        "required": [
          "fact"
        ]
      }
    }
  ]
}
